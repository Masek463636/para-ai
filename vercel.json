{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "functions": {
    "api/analyze.js": {
      "maxDuration": 180
    },
    "api/coach.js": {
      "maxDuration": 60
    }
  }
}
